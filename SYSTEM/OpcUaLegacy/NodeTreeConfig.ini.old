VAR37=name:="TestDouble",parent:="FLD2",type:="Double",path:="DB103.DBD26:REAL",readonly:="false"
VAR38=name:="TestFloat",parent:="FLD2",type:="Float",path:="DB103.DBD26:REAL",readonly:="false"

