;Alarm variables 
; by default only the topmost  Alarm is available in the Variable "SinumerikAlarm1"
;if you want to get the 10 topmost alarms change the Entry "NumOpcUaAlarms" to 10 in the file "runopcua.ini"
VAR70=name:="SinumerikAlarm1",parent:="FLD5",type:="String",path:="/Hmi/OpcUaAlarm1"
VAR71=name:="SinumerikAlarm2",parent:="FLD5",type:="String",path:="/Hmi/OpcUaAlarm2"
VAR72=name:="SinumerikAlarm3",parent:="FLD5",type:="String",path:="/Hmi/OpcUaAlarm3"
VAR73=name:="SinumerikAlarm4",parent:="FLD5",type:="String",path:="/Hmi/OpcUaAlarm4"
VAR74=name:="SinumerikAlarm5",parent:="FLD5",type:="String",path:="/Hmi/OpcUaAlarm5"
VAR75=name:="SinumerikAlarm6",parent:="FLD5",type:="String",path:="/Hmi/OpcUaAlarm6"
VAR76=name:="SinumerikAlarm7",parent:="FLD5",type:="String",path:="/Hmi/OpcUaAlarm7"
VAR77=name:="SinumerikAlarm8",parent:="FLD5",type:="String",path:="/Hmi/OpcUaAlarm8"
VAR78=name:="SinumerikAlarm9",parent:="FLD5",type:="String",path:="/Hmi/OpcUaAlarm9"
VAR79=name:="SinumerikAlarm10",parent:="FLD5",type:="String",path:="/Hmi/OpcUaAlarm10"
VAR80=name:="SinumerikAlarmNumbers",parent:="FLD5",type:="String",path:="/Hmi/OpcUaAlarmNumbers"


;Datatypes:
;Bool, Byte, Word/UInt16, DWord/UInt32, Int/Int16/Integer, DInt/Int32, Double, Float, String
;DateTime is not available 


; Prinzip:
; es gibt einen ROOT Ordner

; es gibt mehrere Ordner Folder (ID/Bez.: FLDxxxx)
; mit dem Attribut parent werden diese anderen Ordnern zugeordnet (dazu wird die ID verwendet)
; name = Name des Knotens
;; nodeId_string = ID des Knotens im Server, in Form eines Strings
;; nodeId_numeric = ID des Knotens im Server, in Form einer Zahl
; nodeIds werden automatisch gebildet

; es gibt Variablen, gekennzeichnet mit: VARxxxx
; werden auch Ordnern zugeordnet mit
; parent = ID des Übergordneten Knotens (FLDxxxx)
; type = Datentyp (Liste aller Möglichen: siehe Programm, noch genau festlegen)
; path = Zugriffspfad auf Variable in Steuerung
; name, nodeId_[...], parent ist gleich wie bei Ordnern

; Principle:
; There is a ROOT folder  

; There are multiple folder nodes (ID/Name: FLDxxxx)  
; They are assigned to other nodes with the parent attribute (using their IDs)  
; name = Node name 
;; nodeId_string = Node ID in the server, in the form of a string  
;; nodeId_numeric = Node ID in the server, in the form of a number
; Node IDs are automatically generated 

; There are variables, marked with: VARxxxx  
; They are also assigned to folders with  
; parent = ID of the parent node (FLDxxxx)  
; type = Data type (List of all possible types: see program, still to be determined exactly)  
; path = Access path to variable in control  
; name, nodeId_[...], parent is the same as for folders  