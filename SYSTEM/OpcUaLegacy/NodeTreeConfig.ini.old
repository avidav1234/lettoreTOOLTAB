[Folders]
FLD0=name:="SINUMERIK PL",parent:="ROOT"

FLD1=name:="NC",parent:="FLD0"

FLD2=name:="PLC",parent:="FLD0"

FLD3=name:="Channel",parent:="FLD1"
FLD4=name:="Parameter",parent:="FLD3"
FLD5=name:="Alarme",parent:="FLD0"

FLD11=name:="Folder1",parent:="FLD1"
FLD12=name:="Folder2",parent:="FLD1"

[Variables]
;NC-variable examples
VAR1=name:="opMode",parent:="FLD1",type:="String",path:="/BAG/State/opmode"

;NC channel -variable examples 
VAR5=name:="Feedrate",parent:="FLD3",type:="Double",path:="/Channel/State/feedRateIpoOvr[u1]"
VAR6=name:="PartProgramName",parent:="FLD3",type:="String",path:="/Channel/ProgramInfo/workPandProgName[u1]"

;NC-Variablen Bsp. R-Parameter
;NC variables example: R-parameters
VAR11=name:="R0",parent:="FLD4",type:="Double",path:="/channel/parameter/R[u1,0]",readonly:="FALSE"
VAR12=name:="R1",parent:="FLD4",type:="Double",path:="/channel/parameter/R[u1,1]",readonly:="FALSE"
VAR13=name:="R2",parent:="FLD4",type:="Double",path:="/channel/parameter/R[u1,2]",readonly:="FALSE"
VAR14=name:="R3",parent:="FLD4",type:="Double",path:="/channel/parameter/R[u1,3]",readonly:="FALSE"
VAR15=name:="R4",parent:="FLD4",type:="Double",path:="/channel/parameter/R[u1,4]",readonly:="FALSE"
VAR16=name:="R5",parent:="FLD4",type:="Double",path:="/channel/parameter/R[u1,5]",readonly:="FALSE"
VAR17=name:="R6",parent:="FLD4",type:="Double",path:="/channel/parameter/R[u1,6]",readonly:="FALSE"
VAR18=name:="R7",parent:="FLD4",type:="Double",path:="/channel/parameter/R[u1,7]",readonly:="FALSE"
VAR19=name:="R8",parent:="FLD4",type:="Double",path:="/channel/parameter/R[u1,8]",readonly:="FALSE"

;Readonly-Variable
VAR20=name:="R9_Readonly",parent:="FLD4",type:="Double",path:="/channel/parameter/R[u1,9]"

;Array mit R-Parametern
;Array with R-parameters
VAR22=name:="RPARAM_Array_asFloat",parent:="FLD4",type:="Float",path:="/channel/parameter/R[u1,0,#10]",readonly:="FALSE"
VAR23=name:="RPARAM_Array_asDouble",parent:="FLD4",type:="Double",path:="/channel/parameter/R[u1,0,#10]",readonly:="FALSE"


;PLC-Variablen, Bsp. für jeden Datentyp
;PLC-Variables, examples for every datatype 
VAR30=name:="TestBool",parent:="FLD2",type:="Bool",path:="DB103.DBX6.0",readonly:="false"
